{
  "name": "wedding-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "app",
    "infrastructure"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace @wedding/app",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspace @wedding/app",
    "preview": "npm run preview --workspace @wedding/app"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "~6.0.2"
  }
}
